# Server configuration
PORT=3000
NODE_ENV=development

# TikTok download provider config
# Options: tikwm, tiktok-api-dl, mock
TIKTOK_PROVIDER=tikwm

# TikWM API configuration (Optional API key for premium/rate-limit bypass)
TIKWM_API_KEY=

# API Key for Apple Shortcuts Integration
SHORTCUT_API_KEY=your_secret_key_here
